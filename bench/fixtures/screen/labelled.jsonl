{"id":"code-python","kind":"code","text":"def two_sum(nums, target):\n    seen = {}\n    for i, n in enumerate(nums):\n        if target - n in seen:\n            return [seen[target - n], i]\n        seen[n] = i"}
{"id":"code-java","kind":"code","text":"public int[] twoSum(int[] nums, int target) {\n  Map<Integer, Integer> seen = new HashMap<>();\n  for (int i = 0; i < nums.length; i++) {\n    int want = target - nums[i];\n  }\n  return new int[] { 0, 1 };\n}"}
