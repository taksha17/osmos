/index.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Secrets — never commit keys or local settings dumps
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
credentials.json
osmos-settings.json
unconventionally-settings.json

